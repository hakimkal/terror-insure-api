# Environment Variables for Cloud Deployment
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_DB=terrondb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Spring DataSource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/terrondb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Application Profile
SPRING_PROFILES_ACTIVE=prod

# JVM Options (adjust based on available memory)
JAVA_OPTS=-Xmx1g -Xms512m

# CORS - Set your frontend URL(s) for security
# Examples:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# Server Port
PORT=8000

# Database Connection Pool
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5
HIKARI_IDLE_TIMEOUT=300000
HIKARI_CONNECTION_TIMEOUT=20000
HIKARI_MAX_LIFETIME=1200000
